                  "$ref": "#/$defs/shadowValue"
                },
                {
                  "$ref": "#/$defs/shadowModes"
                }
              ]
            },
            "$description": {
              "type": "string"
            }
          },
          "required": [
            "$value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "shadowCategory": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/shadowToken"
      }
    },
    "typographyValue": {
      "oneOf": [
        {
          "type": "object",
