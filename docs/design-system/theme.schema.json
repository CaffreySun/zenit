            },
            "line_height": {
              "$ref": "#/$defs/line_heightValue"
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        },
        {
          "type": "string",
          "pattern": "^\\{(?:tokens|semantic)\\.(?:typography)\\.[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_][A-Za-z0-9_-]*)*\\}$"
        }
      ]
    },
    "typographyModes": {
      "type": "object",
      "required": [
        "$light"
      ],
      "patternProperties": {
        "^\\$(?!(?:version|schema|modes|value|description)$)[A-Za-z0-9_][A-Za-z0-9_-]*$": {
          "$ref": "#/$defs/typographyValue"
        }
      },
      "additionalProperties": false
    },
    "typographyToken": {
      "oneOf": [
        {
          "oneOf": [
            {
              "$ref": "#/$defs/typographyValue"
            },
            {
              "$ref": "#/$defs/typographyModes"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "$value": {
              "oneOf": [
                {
                  "$ref": "#/$defs/typographyValue"
                },
                {
                  "$ref": "#/$defs/typographyModes"
                }
              ]
            },
            "$description": {
              "type": "string"
            }
          },
          "required": [
            "$value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "typographyCategory": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/typographyToken"
      }
    },
    "materials": {
      "type": "object",
      "properties": {
        "color": {
          "$ref": "#/$defs/colorCategory"
        },
        "space": {
          "$ref": "#/$defs/spaceCategory"
        },
        "radius": {
          "$ref": "#/$defs/radiusCategory"
        },
        "font_size": {
          "$ref": "#/$defs/font_sizeCategory"
        },
        "font_weight": {
          "$ref": "#/$defs/font_weightCategory"
        },
        "line_height": {
          "$ref": "#/$defs/line_heightCategory"
        },
        "border_width": {
          "$ref": "#/$defs/border_widthCategory"
        },
        "size": {
          "$ref": "#/$defs/sizeCategory"
        },
        "opacity": {
          "$ref": "#/$defs/opacityCategory"
        },
        "duration": {
          "$ref": "#/$defs/durationCategory"
        },
        "breakpoint": {
          "$ref": "#/$defs/breakpointCategory"
        },
        "shadow": {
          "$ref": "#/$defs/shadowCategory"
        },
        "typography": {
          "$ref": "#/$defs/typographyCategory"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
