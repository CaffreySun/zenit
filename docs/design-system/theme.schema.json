    "shadowValue": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "color": {
              "$ref": "#/$defs/colorValue"
            },
            "blur": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\{(?:tokens|semantic)\\.(?:space|size)\\.[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_][A-Za-z0-9_-]*)*\\}$"
                }
              ]
            },
            "spread": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^\\{(?:tokens|semantic)\\.(?:space|size)\\.[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_][A-Za-z0-9_-]*)*\\}$"
                }
              ]
            },
            "offset_x": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^\\{(?:tokens|semantic)\\.(?:space|size)\\.[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_][A-Za-z0-9_-]*)*\\}$"
                }
              ]
            },
            "offset_y": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^\\{(?:tokens|semantic)\\.(?:space|size)\\.[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_][A-Za-z0-9_-]*)*\\}$"
                }
              ]
            }
          },
          "required": [
            "color"
          ],
          "additionalProperties": false,
          "description": "未声明的 blur/spread/offset_x/offset_y 均按 0 生成；不采用 Zig Shadow 的原始默认值。"
        },
        {
          "type": "string",
          "pattern": "^\\{(?:tokens|semantic)\\.(?:shadow)\\.[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_][A-Za-z0-9_-]*)*\\}$"
        }
      ]
    },
    "shadowModes": {
      "type": "object",
      "required": [
        "$light"
      ],
      "patternProperties": {
        "^\\$(?!(?:version|schema|modes|value|description)$)[A-Za-z0-9_][A-Za-z0-9_-]*$": {
          "$ref": "#/$defs/shadowValue"
        }
