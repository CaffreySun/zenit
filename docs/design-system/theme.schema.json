{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zenit Design System Tokens v1（设计规格）",
  "description": "结构校验。合并消费路径的唯一性及 token/分组冲突、引用存在性、基础到 semantic 的依赖方向、已注册模式/回退图、引用环、f32 可表示范围由生成器校验。JSON 重复键须在解析前校验。",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$version": {
      "type": "integer",
      "const": 1
    },
    "$modes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$",
        "not": {
          "enum": [
            "light",
            "dark",
            "version",
            "schema",
            "modes",
            "value",
            "description"
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "scheme": {
            "enum": [
              "light",
              "dark"
            ]
          },
          "fallback": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
          }
        },
        "required": [
          "scheme",
          "fallback"
        ],
        "additionalProperties": false
      }
    },
    "tokens": {
      "$ref": "#/$defs/materials"
    },
    "semantic": {
      "$ref": "#/$defs/materials"
    }
  },
  "required": [
    "$version",
    "tokens"
  ],
  "additionalProperties": false,
  "$defs": {
    "colorValue": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        {
          "type": "string",
          "pattern": "^\\{(?:tokens|semantic)\\.(?:color)\\.[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_][A-Za-z0-9_-]*)*\\}$"
        }
      ]
    },
    "colorModes": {
      "type": "object",
      "required": [
        "$light"
      ],
      "patternProperties": {
        "^\\$(?!(?:version|schema|modes|value|description)$)[A-Za-z0-9_][A-Za-z0-9_-]*$": {
          "$ref": "#/$defs/colorValue"
        }
      },
      "additionalProperties": false
    },
    "colorToken": {
      "oneOf": [
        {
          "oneOf": [
            {
              "$ref": "#/$defs/colorValue"
            },
            {
              "$ref": "#/$defs/colorModes"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "$value": {
              "oneOf": [
                {
                  "$ref": "#/$defs/colorValue"
                },
                {
                  "$ref": "#/$defs/colorModes"
                }
              ]
            },
            "$description": {
              "type": "string"
            }
          },
          "required": [
            "$value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "colorNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/colorToken"
        },
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/colorNode"
          }
        }
      ]
    },
    "colorCategory": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/colorNode"
