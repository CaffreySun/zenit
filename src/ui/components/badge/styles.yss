//! Badge / StatusBadge styling: color, size, spacing, font all reference tokens.
//! View in badge.yix; BadgeStatus / BadgeSize are public API, defined in mod.zig.
const ui = @import("../../ui.zig");

/// Badge: root is capsule (pill, corner full), label is text inside. status
/// determines bg and text color, size determines height / padding / font, dot
/// shrinks root to 8x8 dot.
recipe Badge slots(root, label) {
  base {
    root { width: fit; justify: center; align-items: center; corner-radius: full; }
    label { font-weight: 600; }
  }
  variant status = info {
    info    { root { background: accent; }  label { color: button-primary-fg; } }
    success { root { background: success; } label { color: button-primary-fg; } }
    warning { root { background: warning; } label { color: button-primary-fg; } }
    error   { root { background: danger; }  label { color: #ffffff; } }
  }
  variant size = md {
    sm { root { height: md; padding: space50 space150; } label { font-size: 10; } }
    md { root { height: lg; padding: space50 space200; } label { font-size: xs; } }
  }
  flag dot;
  // Dot mode overrides height and padding from size dimension
  when dot { root { width: 8; height: 8; padding: 0; corner-radius: 4; } }
}

/// StatusBadge: status dot + label.
style status_row { width: fit; height: fit; direction: row; gap: 6; align-items: center; }

/// 8x8 status dot (same size as Badge dot mode), bg color same as Badge status
recipe StatusDot {
  base { width: 8; height: 8; padding: 0; corner-radius: 4; }
  variant status = info {
    info    { background: accent; }
    success { background: success; }
    warning { background: warning; }
    error   { background: danger; }
  }
}

style status_label { color: fg-primary; font-size: 12; }
