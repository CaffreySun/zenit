//! Button view. Styles and drawing in styles.yss, shared types and tests in mod.zig.
const ui = @import("../../ui.zig");
const core = @import("../../core.zig");
const S = @import("styles.yss");
const ButtonVariant = S.ButtonVariant;
const ButtonSize = S.ButtonSize;

/// Button semantics: name taken from a11yLabel, else label (falls back to child text if neither),
/// disabled, loading (busy)
fn a11yOf(name: []const u8, text: []const u8, disabled: bool, loading: bool) ui.A11yProps {
    const resolved = if (name.len > 0) name else text;
    return .{ .role = .button, .label = if (resolved.len > 0) resolved else null, .disabled = disabled, .busy = loading };
}

/// Button: W.Button(.{ .label = "Save", .disabled = ui.not(dirty), .on_click = cx.on(S, s, S.save)
/// }).
/// label / variant / loading / disabled can come from signals; disabled or loading suppresses click
/// response, loading shows spinner and hides icon.
/// Hover / pressed (held with pointer still inside) changes background; base_style / hover_style /
/// pressed_style override recipe (style reserved for root node attrs).
/// on_event is low-level generic event callback (not called when disabled, called when loading);
/// event_context is its context.
/// a11yLabel names the button for assistive tech without rendering text (icon-only buttons).
pub fn Button(
    label: Text = "",
    variant: ButtonVariant = .primary,
    size: ButtonSize = .md,
    iconOnly: bool = false,
    loading: bool = false,
    disabled: bool = false,
    focusRing: ui.FocusRingConfig = .{},
    block: bool = false,
    onClick: ?Handler(void) = null,
    icon: ?u32 = null,
    iconAsset: ?ui.SvgAsset = null,
    iconSize: ?f32 = null,
    iconTint: ?ui.Color = null,
    onEvent: ?core.GenericEventCallback = null,
    eventContext: ?*anyopaque = null,
    baseStyle: core.StyleOverride = .{},
    hoverStyle: ?core.StyleOverride = null,
    pressedStyle: ?core.StyleOverride = null,
    a11yLabel: []const u8 = "",
) View {
    const has_svg = computed(iconAsset != null);
    const has_texture = computed(iconAsset == null and icon != null);
    const icon_slot = computed(iconAsset != null or icon != null or loading);
    const content_slot = computed(label.len != 0 or !icon_slot);
    const shape = computed(S.Shape{ .variant = variant, .size = size, .icon_only = iconOnly, .leading_icon = !iconOnly and icon_slot and label.len != 0, .disabled = disabled, .block = block, .style = baseStyle, .hover_style = hoverStyle, .pressed_style = pressedStyle });
    const look = computed(S.Look{ .variant = variant, .size = size, .disabled = disabled, .style = baseStyle, .tint = iconTint, .icon_size = iconSize });
    const slot = computed(S.Slot{ .size = size, .icon_only = iconOnly });
    const semantics = computed(a11yOf(a11yLabel, label, disabled, loading));
    const enabled = computed(!disabled);
    const idle = computed(!loading);
    const events = computed(if (disabled) null else onEvent);
    return (
        <row
            style={.{ ui.view.statesBy(shape, S.root), S.fade }}
            focusable={enabled}
            focusRing={focusRing}
            a11y={semantics}
            onClick={if (!disabled and !loading) onClick}
            onEvent={events}
            eventContext={eventContext}
        >
            {if (icon_slot)
                <box style={ui.view.styleBy(slot, S.iconSlot)}>
                    {if (has_svg) <icon style={ui.view.styleBy(look, S.icon)} tint={ui.view.tintBy(look, S.iconTint)} visible={idle} src={iconAsset} />}
                    {if (has_texture) <image style={ui.view.styleBy(look, S.icon)} tint={ui.view.tintBy(look, S.iconTint)} visible={idle} src={icon} />}
                    {if (loading) <box style={ui.view.styleBy(size, S.spinnerBox)}><canvas style={S.spinner_canvas} draw={S.drawSpinner} data={look} animate /></box>}
                </box>
            }
            {if (content_slot) <row style={ui.view.styleBy(size, S.contentSlot)}>{if (label.len != 0) <text style={ui.view.styleBy(look, S.label)}>{label}</text>}</row>}
        </row>
    );
}
