//! Modal styles: dialog panel, title bar, close button, body. Panel view in modal.yix, popover /
//! focus trap / animation in mod.zig.
const ui = @import("../../ui.zig");

/// Dialog panel: fixed width, grows with content up to max-height; default background bg-secondary.
/// Double-layer shadow: main theme shadow + large-extent ambient light soft shadow (simulates
/// extreme modal elevation, MD3 style).
style dialog($width: f32, $max_height: f32, $background: ?ui.Color = null) {
  width: $width;
  height: {.{ .fit = .{ .max = $max_height } }};
  background: $background ?? bg-secondary;
  direction: column;
  corner-radius: 8;
  shadow: lg, 0 32 80 #00000019;
}

/// Title bar: title + close button space-between
style header { direction: row; justify: space-between; align-items: center; gap: 12; padding: 12 16; width: grow; border: 0 separator; }
style title { color: fg-primary; font-size: 14; font-weight: 600; wrap: word; }
/// Close button: 24x24
style close_button { width: 24; height: 24; background: transparent; justify: center; align-items: center; corner-radius: 4; }
/// Text X fallback when no icon asset (24x24, same geometry as close button, no corner radius)
style close_glyph_box { width: 24; height: 24; background: transparent; justify: center; align-items: center; }
style close_glyph { color: fg-secondary; font-size: 14; }
style body { direction: column; width: grow; height: grow; padding: 16; }
style close_icon { width: 14; height: 14; icon-color: fg-secondary; }
