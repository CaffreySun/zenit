//! Timeline styles: status determines dot / connector color and title color / font-weight; all
//! colors reference tokens.
//! View in timeline.yix; TimelineStatus is public API defined in mod.zig.
const ui = @import("../../ui.zig");

pub const dot_size: f32 = 12;

/// One row: indicator column (dot + connector), content column (title / description / time)
recipe Row slots(dot, line, title) {
  base {
    dot { width: 12; height: 12; corner-radius: 6; }
    line { width: 2; height: grow; }
    title { font-size: md; }
  }
  variant status = pending {
    completed { dot { background: success; } line { background: success; } title { color: fg-primary; font-weight: 400; } }
    active    { dot { background: accent; }  line { background: border; }  title { color: fg-primary; font-weight: 600; } }
    pending   { dot { background: border; }  line { background: border; }  title { color: fg-secondary; font-weight: 400; } }
  }
}

style list { width: grow; height: fit; direction: column; }
style row { width: fill; height: {.{ .fit = .{ .min = 48 } }}; gap: 12; }
style indicator { width: 24; height: grow; direction: column; align-items: center; }

/// Content column; last row has no bottom padding
recipe Content {
  base { width: fill; height: fit; direction: column; gap: 2; padding: 0 0 16 0; }
  flag last { padding: 0; }
}

style description { color: fg-secondary; font-size: sm; }
style time { color: fg-disabled; font-size: xs; }
